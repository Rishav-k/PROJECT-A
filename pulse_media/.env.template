# ─────────────────────────────────────────
# Pulse Media Group — API Keys
# STEP 1: Copy this file → rename to .env
# STEP 2: Fill in your real keys below
# STEP 3: Never share or commit this file (see ../.gitignore)
# ─────────────────────────────────────────

# AI caption backend — pick ONE (both are free), or leave both blank
# to fall back to the zero-dependency template backend.
# Groq: https://console.groq.com | Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=gsk_REPLACE_ME
GEMINI_API_KEY=AIzaREPLACE_ME

# NewsData.io — get from newsdata.io (free)
NEWSDATA_API_KEY=pub_REPLACE_ME

# Dashboard login (optional — defaults to pulse / pulse2024 if unset)
DASHBOARD_USER=REPLACE_ME
DASHBOARD_PASS=REPLACE_ME

# ngrok — public tunnel for the dashboard (start_pulse.sh)
# Get a free token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_TOKEN=REPLACE_ME

# Instagram — one username/password pair per page (instagrapi login,
# not the Meta Graph API). Only fill in the pages you actually run.
INSTAGRAM_FINPULSE_USERNAME=REPLACE_ME
INSTAGRAM_FINPULSE_PASSWORD=REPLACE_ME

INSTAGRAM_TECHPULSE_USERNAME=REPLACE_ME
INSTAGRAM_TECHPULSE_PASSWORD=REPLACE_ME

INSTAGRAM_CORPPULSE_USERNAME=REPLACE_ME
INSTAGRAM_CORPPULSE_PASSWORD=REPLACE_ME

INSTAGRAM_WORLDPULSE_USERNAME=REPLACE_ME
INSTAGRAM_WORLDPULSE_PASSWORD=REPLACE_ME
